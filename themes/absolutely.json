{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "terracotta": "#cc7d5e",
    "terracottaMuted": "#bc7559",
    "terracottaLight": "#d28e73",
    "lightBg": "#f9f9f7",
    "lightPanel": "#f4f4f2",
    "lightElement": "#ecebe6",
    "lightFg": "#2d2d2b",
    "lightMuted": "#7c7b76",
    "lightComment": "#939391",
    "lightBorder": "#dcdbd5",
    "lightBorderSubtle": "#eae9e4",
    "darkBg": "#2d2d2b",
    "darkPanel": "#252523",
    "darkElement": "#373735",
    "darkFg": "#f9f9f7",
    "darkMuted": "#b2b2b0",
    "darkBorder": "#454542",
    "darkBorderSubtle": "#373735",
    "green": "#00c853",
    "red": "#ff5f38"
  },
  "theme": {
    "primary": { "dark": "terracotta", "light": "terracotta" },
    "secondary": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "accent": { "dark": "terracotta", "light": "terracotta" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "terracotta", "light": "terracotta" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "terracotta", "light": "terracotta" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#1b3324", "light": "#e6f7ed" },
    "diffRemovedBg": { "dark": "#3b231e", "light": "#ffebe6" },
    "diffContextBg": { "dark": "darkBg", "light": "lightBg" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#1b3324", "light": "#e6f7ed" },
    "diffRemovedLineNumberBg": { "dark": "#3b231e", "light": "#ffebe6" },
    "markdownText": { "dark": "darkFg", "light": "lightFg" },
    "markdownHeading": { "dark": "terracotta", "light": "terracotta" },
    "markdownLink": { "dark": "terracotta", "light": "terracotta" },
    "markdownLinkText": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "markdownStrong": { "dark": "terracotta", "light": "terracotta" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "terracotta", "light": "terracotta" },
    "markdownListEnumeration": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "markdownImage": { "dark": "terracotta", "light": "terracotta" },
    "markdownImageText": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "lightFg" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightComment" },
    "syntaxKeyword": { "dark": "red", "light": "red" },
    "syntaxFunction": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "syntaxVariable": { "dark": "darkFg", "light": "lightFg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "red", "light": "red" },
    "syntaxType": { "dark": "terracottaLight", "light": "terracottaMuted" },
    "syntaxOperator": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxPunctuation": { "dark": "darkFg", "light": "lightFg" }
  }
}
